  "item": [
    {
      "name": "S-API-01. Авторизация: получение ключа доступа",
      "item": [
        {
          "name": "Получение API-ключа",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response is array of keys\", function () {",
                  "    pm.expect(jsonData).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"token\", jsonData[0].key);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"login\": \"{{login}}\",\n    \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/keys/get",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "keys",
                "get"
              ]
            }
          },
          "response": []
        }
      ]
    },
